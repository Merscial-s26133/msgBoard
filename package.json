{
  "name": "kic-web-application-starter",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly web application starter for a KIC lecture",
  "scripts": {
    "build": "esbuild public/app.js --bundle --platform=browser --format=iife --target=es2020 --outfile=public/app.bundle.js",
    "start": "npm run build && node server.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "esbuild": "^0.28.2",
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=18"
  }
}
